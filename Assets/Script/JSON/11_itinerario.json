    "PERCORSI_TEXT": [
        {
            "id": 11000011,
            "percorso_id": "1100001",
            "descrizione_breve": "Itinerario naturalistico",
            "descrizione": "<span style=\"font-weight: 400\">Si partir\u00e0 dalla Chiesa di Palente in direzione ovest che condurr\u00e0 verso il valico di Torre di Mistrano per arrivare al ponte del fosso di Figareto. Si proseguir\u00e0 poi attraverso un suggestivo sentiero fino alla sorgente di Figareto. Il percorso continuer\u00e0 in direzione di Selvazzano, un idilliaco borgo sospeso sulla rupe. Di ritorno verso la Chiesa di Palente sar\u00e0 possibile fare una sosta presso una delle strutture ricettive nelle vicinanze.\u00a0<\/span><span style=\"font-weight: 400\">\r\n<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-17 12:30:43",
