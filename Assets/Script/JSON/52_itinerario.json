    "PERCORSI_TEXT": [
        {
            "id": 52000011,
            "percorso_id": "5200001",
            "descrizione_breve": "Assapora la storia, sfiora i mestieri e osserva l\u2019arte prendere vita.\r\nNei luoghi in cui i materiali vengono plasmati, gli artigiani custodiscono la memoria dei gesti antichi.\r\n",
            "descrizione": "<span style=\"font-weight: 400\">Il percorso ti accompagner\u00e0 a conoscere le principali botteghe degli artigiani locali che si renderanno disponibili a raccontare tutto ci\u00f2 che caratterizza la loro arte, in alcuni casi tramandata di generazione in generazione.<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-21 09:02:56",
            "uuid": ""
        },
        {
            "id": 52000012,
            "percorso_id": "5200001",
            "descrizione_breve": [],
            "descrizione": [],
            "lingua_id": 2,
            "attivo": "Y",
            "mod_dte": "2025-07-21 09:02:56",
            "uuid": ""
        },
        {
            "id": 52000021,
            "percorso_id": "5200002",
            "descrizione_breve": "Rendi il tuo soggiorno un viaggio indimenticabile: passeggia tra le vie di un grazioso borgo, lasciati sorprendere da scorci inaspettati e perditi tra le campagne rigogliose del territorio maceratese.\r\n",
            "descrizione": "<span style=\"font-weight: 400\">Un weekend all\u2019insegna del relax, dell\u2019arte e della natura. Il percorso ti guider\u00e0 attraverso il cuore storico di Pollenza, tra chiese, palazzi, musei e vedute panoramiche, con una seconda giornata dedicata all\u2019esplorazione dei paesi vicini.<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-21 09:02:56",
            "uuid": ""
        },
        {
            "id": 52000022,
