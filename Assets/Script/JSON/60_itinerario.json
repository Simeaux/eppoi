        {
            "id": 60000021,
            "percorso_id": "6000002",
            "descrizione_breve": "x",
            "descrizione": "<span style=\"font-weight: 400\">Il percorso porter\u00e0 il visitatore alla scoperta del parco archeologico che si snoda in sentieri suggestivi per circa 40 ettari. L'itinerario toccher\u00e0 il Serbatoio dell\u2019acquedotto, il Teatro romano, l\u2019Edificio a Nicchioni e il tempio con criptoportico. Al di fuori delle mura si potr\u00e0 visitare l\u2019antico Anfiteatro. \u00c8 inoltre consigliata la visita al Museo Archeologico Statale.<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-21 09:13:35",
