    "PERCORSI_TEXT": [
        {
            "id": 60000011,
            "percorso_id": "6000001",
            "descrizione_breve": "x",
            "descrizione": "<span style=\"font-weight: 400\">L\u2019itinerario sar\u00e0 volto a far conoscere al visitatore il bellissimo centro storico del paese. Si partir\u00e0 dalla Rocca per poi dirigersi verso Piazza Garibaldi, sulla quale si affaccia la Collegiata di San Lorenzo. Dalla piazza, lungo Corso Giannelli, si proseguir\u00e0 in direzione della Chiesa dell\u2019Addolorata, la pi\u00f9 antica del borgo. Poco dopo la chiesa il visitatore continuer\u00e0 verso Palazzo Brunelli e verso la Torre Campanaria. Da questo punto si potranno ammirare Porta Trento e Porta Piave, gli antichi accessi al castello medievale. Percorrendo Corso Giannelli si incontreranno il Palazzo Comunale, la Chiesa di San Giorgio e Porta Vittoria, oltre la quale si trover\u00e0 il Parco della Rimembranza.\u00a0<\/span><span style=\"font-weight: 400\">\r\n<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-21 09:13:35",
            "uuid": ""
        },
