    "PERCORSI_TEXT": [
        {
            "id": 50000011,
            "percorso_id": "5000001",
            "descrizione_breve": "Il percorso accompagner\u00e0 il visitatore a scoprire i principali punti di interesse del paese.",
            "descrizione": "<span style=\"font-weight: 400\">Si partir\u00e0 un po\u2019 fuori dal centro abitato visitando la Chiesa del SS Crocifisso e si proseguir\u00e0 verso il sentiero dei \u201cVurgacci\u201d fino al centro del paese, uscita via Lampleto Eustacchi. Il percorso continuer\u00e0 in direzione della chiesa della \u201cMadonna della Grotta\u201d, verso l\u2019Eremo di San Vittorino e verso l\u2019Antico Lavatoio.<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-21 09:02:21",
            "uuid": ""
        },
        {
            "id": 50000012,
