        {
            "id": "0061005255",
            "poi_id": "0061005255",
            "descrizione_breve": "Alloggio e ristorazione.\r\nSituato nel cuore del Parco Nazionale dei Monti Sibillini, a quota 1811 m.",
            "descrizione": "",
            "lingua_id": 1,
