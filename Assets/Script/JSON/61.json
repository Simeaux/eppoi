            "lingua_id": 2,
            "attivo": "Y",
            "mod_dte": "2025-07-21 09:13:35",
            "uuid": ""
        },
        {
            "id": "0061005552",
            "poi_id": "0061005552",
            "descrizione_breve": "Ricostruita nel 1926 dalla famiglia Sili sui resti di una precedente struttura romanica.",
            "descrizione": "<br>\r\nLa facciata presenta un rosone e un portale in pietra con lunetta in ceramica, opera di Silvio Galimberti, nella quale sono raffigurati Sant\u2019Andrea, il Cardinale Augusto Sili in ginocchio e sullo sfondo la chiesa con il Monte Bove. La chiesa venne consacrata il 5 settembre del 1932. Gli affreschi del XIV e XV secolo sono stati conservati, \u00e8 possibile ammirarli ai lati dell\u2019ingresso e lungo le pareti.",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-21 09:13:35",
            "uuid": ""
        },
