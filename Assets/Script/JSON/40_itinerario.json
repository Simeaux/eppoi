    "PERCORSI_TEXT": [
        {
            "id": 40000011,
            "percorso_id": "4000001",
            "descrizione_breve": "Religione e natura: un rapporto ancestrale, scolpito nelle chiese solitarie e nel bisogno umano di riconoscere il sacro nelle terre che abita.",
            "descrizione": "<span style=\"font-weight: 400\">Itinerario ad anello pensato per escursionisti e camminatori curiosi, che non si lasciano intimorire dalla lunghezza del viaggio, ma che cercano nel cammino un\u2019occasione per ritrovare se stessi.\u00a0<\/span>\r\n\r\n<span style=\"font-weight: 400\">A ogni tappa una chiesa diversa. Segni di fede e storia punteggiano il territorio di Monte Cavallo.<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 40000012,
            "percorso_id": "4000001",
            "descrizione_breve": [],
            "descrizione": [],
            "lingua_id": 2,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 40000021,
            "percorso_id": "4000002",
            "descrizione_breve": "Madre Natura diventa protagonista rendendoti partecipe di un\u2019incantevole scenografia, in cui monti, cascate e distese verdeggianti si fondono in perfetta armonia.",
            "descrizione": "<span style=\"font-weight: 400\">Il percorso ad anello ti condurr\u00e0 alla scoperta delle bellezze naturali di questo territorio: attraversando le frazioni di <\/span><b>Selvapiana<\/b><span style=\"font-weight: 400\">, <\/span><b>Cesure<\/b><span style=\"font-weight: 400\"> e <\/span><b>Valcaldara<\/b><span style=\"font-weight: 400\"> ti sembrer\u00e0 di entrare in un quadro impressionista.\r\n<\/span><span style=\"font-weight: 400\">L\u2019<\/span><b>Oasi Faunistica Naturalistica del Monte Fietone e del Monte Cesure<\/b><span style=\"font-weight: 400\"> ti regaler\u00e0 incontri suggestivi con una natura verace, capace di toccare anche gli animi pi\u00f9 distratti.\r\n<\/span><span style=\"font-weight: 400\">Itinerario perfetto per chi cerca un\u2019esperienza che unisca mente e cuore.<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
