    "TAPPE_TEXT": [
        {
            "id": 4000001011,
            "tappa_id": 400000101,
            "descrizione_breve": "",
            "descrizione": "<span style=\"font-weight: 400\">Punto di partenza ideale per tutti coloro che amano addentrarsi nella natura incontaminata, <\/span><b>Collattoni<\/b><span style=\"font-weight: 400\"> \u00e8 una piccolissima frazione di Monte Cavallo, che custodisce nella sua memoria storica una pagina drammatica del periodo della Resistenza. Nella primavera del 1944, infatti, un gruppo di 45 partigiani fu attaccato di sorpresa dalle forze tedesche e molti di loro non sopravvissero. Oggi questo luogo \u00e8 diventato il simbolo della lotta per la libert\u00e0 e di solidariet\u00e0 tra i popoli.<\/span>\r\n\r\n<span style=\"font-weight: 400\">Al centro del borgo, a un\u2019altitudine di circa 1000 metri, si erge la <\/span><b>Chiesa di San Pietro<\/b><span style=\"font-weight: 400\">, antico edificio risalente al XV secolo e ricostruito nel XIX secolo. L\u2019esterno \u00e8 realizzato con blocchi di pietra irregolari e inserti in laterizio. L\u2019interno \u00e8 abbellito da decorazioni in legno e due affreschi raffiguranti la Madonna del Rosario e la Crocefissione del Cristo.\u00a0<\/span>\r\n\r\n<span style=\"font-weight: 400\">Poco pi\u00f9 avanti sorge una piccola chiesa, denominata <\/span><b>Chiesa dello Spirito Santo<\/b><span style=\"font-weight: 400\">, costruita dai fedeli locali per offrire un momento di devozione e di fede anche ai viandanti, grazie alle sue due finestre che si affacciano sulla strada.<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000001012,
            "tappa_id": 400000101,
            "descrizione_breve": "",
            "descrizione": null,
            "lingua_id": 2,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000001021,
            "tappa_id": 400000102,
            "descrizione_breve": "",
            "descrizione": "<span style=\"font-weight: 400\">Continua in direzione di <\/span><b>Selvapiana<\/b><span style=\"font-weight: 400\"> per circa 1.5 Km. Potrai scegliere se fare una piccola deviazione per <\/span><b>Cascine<\/b><span style=\"font-weight: 400\"> o se proseguire direttamente lungo la strada principale per raggiungere la <\/span><b>Chiesa di Sant\u2019Anna<\/b><span style=\"font-weight: 400\">, anche detta <\/span><b>Edicola di Selvapiana<\/b><span style=\"font-weight: 400\">, al cui interno \u00e8 custodito un affresco rinascimentale raffigurante la Madonna con Ges\u00f9 Bambino.<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000001022,
            "tappa_id": 400000102,
            "descrizione_breve": "",
            "descrizione": null,
            "lingua_id": 2,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000001031,
            "tappa_id": 400000103,
            "descrizione_breve": "",
            "descrizione": "<span style=\"font-weight: 400\">Al centro di Selvapiana, distaccata dalle abitazioni, la <\/span><b>Chiesa di San Cristoforo<\/b><span style=\"font-weight: 400\"> si affaccia su un piccolo spiazzo pavimentato con cubetti di porfido e circondato da aceri.<\/span>\r\n\r\n<span style=\"font-weight: 400\">L\u2019edificio in muratura presenta una facciata semplice e priva di ornamenti e un campanile sul lato sud con cui si richiamano alla preghiera i fedeli locali. All\u2019interno sono custoditi un dipinto di una Madonna in gloria tra angeli e santi, tra cui Giovanni Battista e la Maddalena, e una croce di lamine d\u2019argento risalente al XV secolo.<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000001032,
            "tappa_id": 400000103,
            "descrizione_breve": "",
            "descrizione": null,
            "lingua_id": 2,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000001041,
            "tappa_id": 400000104,
            "descrizione_breve": "",
            "descrizione": "<span style=\"font-weight: 400\">Segui il profilo collinare in direzione di <\/span><b>Valcaldara<\/b><span style=\"font-weight: 400\">, frazione immersa in paesaggi naturali ricchi di biodiversit\u00e0 e conosciuta per il torrente omonimo che scorre ai piedi del Monte Fietone. In primavera le sorgenti, che sgorgano direttamente dal terreno, dette \u201cVene di Valcaldara\u201d, danno vita a un piacevole spettacolo fiabesco.<\/span>\r\n\r\n<span style=\"font-weight: 400\">Prima di raggiungere i ruderi dell\u2019antico castello dei da Varano puoi fare una breve sosta all\u2019ombra degli alberi della <\/span><b>Chiesetta delle Vene di Valcaldara<\/b><span style=\"font-weight: 400\">, che offre quiete e ristoro a tutti i viandanti. <\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000001042,
            "tappa_id": 400000104,
            "descrizione_breve": "",
            "descrizione": null,
            "lingua_id": 2,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000001051,
            "tappa_id": 400000105,
            "descrizione_breve": "",
            "descrizione": "<span style=\"font-weight: 400\">La <\/span><b>Chiesa castellare di San Nicol\u00f2<\/b><span style=\"font-weight: 400\"> si distingue dalle pievi per la sua origine legata alla nobilt\u00e0 locale. Nei suoi pressi sorgono i ruderi del castello di Valcaldara che un tempo sorvegliava la strada che collegava la Valle di San Benedetto alla piana di Colfiorito. L\u2019interno della chiesa \u00e8 ricco di affreschi del Quattrocento.<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000001052,
            "tappa_id": 400000105,
            "descrizione_breve": "",
            "descrizione": null,
            "lingua_id": 2,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000001061,
            "tappa_id": 400000106,
            "descrizione_breve": "",
            "descrizione": "<span style=\"font-weight: 400\">Continua il cammino verso la frazione <\/span><b>Cesure<\/b><span style=\"font-weight: 400\">, circondata dall\u2019<\/span><b>Oasi Naturalistica di Monte Fietone e di Monte Cesure<\/b><span style=\"font-weight: 400\">, area protetta e habitat naturale dell\u2019aquila reale, della coturnice, del lupo, della puzzola e del capriolo. <\/span><span style=\"font-weight: 400\">\r\n<\/span><span style=\"font-weight: 400\">Al centro del borgo sorge la <\/span><b>Chiesa di Santo Stefano<\/b><span style=\"font-weight: 400\"> del XVIII secolo, nota come \"de Laquisori\" o \"de Clusuris\". Nel 1603, durante una visita pastorale, venne definita \"parrocchiale de villa Cesurarum\".<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000001062,
            "tappa_id": 400000106,
            "descrizione_breve": "",
            "descrizione": null,
            "lingua_id": 2,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000001071,
            "tappa_id": 400000107,
            "descrizione_breve": "",
            "descrizione": "<span style=\"font-weight: 400\">La <\/span><b>Chiesa di San Benedetto<\/b><span style=\"font-weight: 400\"> domina la <\/span><b>Valle di San Benedetto<\/b><span style=\"font-weight: 400\">, una piccola frazione situata in una gola immersa nel verde. L\u2019edificio risalente al XIII secolo era annesso a un antico monastero benedettino.<\/span>\r\n\r\n<span style=\"font-weight: 400\">All\u2019interno della chiesa sono conservati numerosi affreschi del 1572 attribuiti a Fabio Angelucci per celebrare la vittoria di Lepanto.<\/span>\r\n\r\n<span style=\"font-weight: 400\">Tra il XVII e il XVIII secolo l\u2019edificio sub\u00ec numerosi interventi di ristrutturazione che ne modificarono l\u2019aspetto originario. All\u2019esterno, tuttavia, sono ancora visibili alcuni elementi architettonici della costruzione medievale.<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000001072,
            "tappa_id": 400000107,
            "descrizione_breve": "",
            "descrizione": null,
            "lingua_id": 2,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000001081,
            "tappa_id": 400000108,
            "descrizione_breve": "",
            "descrizione": "<span style=\"font-weight: 400\">Situata alle porte di Monte Cavallo, la <\/span><b>Chiesa del Santissimo Nome di Maria<\/b><span style=\"font-weight: 400\"> ti accoglie con una facciata sobria caratterizzata dal portale d\u2019ingresso, in stile neo-romanico, sormontato da un rosone decorato con una croce centrale e petali disposti a raggiera.<\/span>\r\n\r\n<span style=\"font-weight: 400\">Edificata dopo il secondo dopoguerra, \u00e8 diventata la chiesa di riferimento degli abitanti del paese, dato che la Chiesa di San Benedetto si trova in una posizione meno accessibile.<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000001082,
            "tappa_id": 400000108,
            "descrizione_breve": "",
            "descrizione": null,
            "lingua_id": 2,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000001091,
            "tappa_id": 400000109,
            "descrizione_breve": "",
            "descrizione": "<span style=\"font-weight: 400\">Dal centro del paese dirigiti verso <strong>Pantaneto<\/strong>, frazione arroccata sopra uno sperone roccioso a pi\u00f9 di 1000 metri di altitudine e a 500 metri dal fondo valle.<\/span>\r\n\r\n<span style=\"font-weight: 400\">In epoca medievale era un rifugio difensivo completamente autosufficiente, dotato di acqua e terra fertile, circondato da rupi naturali che impedivano le incursioni o visite poco gradite.<\/span>\r\n\r\n<span style=\"font-weight: 400\">La <\/span><b>Chiesa di Santa Maria Assunta<\/b><span style=\"font-weight: 400\"> risale agli anni Sessanta ed \u00e8 una costruzione sobria ed essenziale, priva di qualsiasi decorazione. Solo all\u2019interno custodisce una croce in rame dorato risalente al XVI secolo.<\/span>\r\n\r\n<span style=\"font-weight: 400\">Concludi il percorso ritornando a Collattoni.<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000001092,
            "tappa_id": 400000109,
            "descrizione_breve": "",
            "descrizione": null,
            "lingua_id": 2,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000002011,
            "tappa_id": 400000201,
            "descrizione_breve": "",
            "descrizione": "<b>Selvapiana<\/b><span style=\"font-weight: 400\">, frazione di Monte Cavallo, \u00e8 il punto di partenza ideale per escursionisti e camminatori: in meno di 3 km si raggiunge la cima del Monte Fietone, a circa 1.388 metri di altitudine. <\/span><span style=\"font-weight: 400\">\r\n<\/span><span style=\"font-weight: 400\">Da qui si apre una spettacolare vista sui Monti Sibillini e, con un po\u2019 di fortuna, potrai osservare il volo maestoso dell\u2019aquila reale. <\/span><span style=\"font-weight: 400\">\r\n<\/span><span style=\"font-weight: 400\">L\u2019<\/span><b>Oasi Faunistica e Naturalistica del Monte Fietone e del Monte Cesure<\/b><span style=\"font-weight: 400\"> \u00e8 infatti l\u2019habitat di numerose specie protette, tra cui l\u2019aquila reale e la coturnice.<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000002012,
            "tappa_id": 400000201,
            "descrizione_breve": "",
            "descrizione": null,
            "lingua_id": 2,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000002021,
            "tappa_id": 400000202,
            "descrizione_breve": "",
            "descrizione": "<span style=\"font-weight: 400\">Prosegui il cammino per circa 5 km all\u2019interno di boschi ombrosi e ampie vallate e arriverai al borgo <\/span><b>Cesure<\/b><span style=\"font-weight: 400\">, un piccolo agglomerato di case raccolte attorno alla <\/span><b>Chiesa di Santo Stefano<\/b><span style=\"font-weight: 400\">. Potrai fare rifornimento d\u2019acqua alla fonte presso l\u2019ingresso del borgo.<\/span><span style=\"font-weight: 400\">\r\n<\/span><span style=\"font-weight: 400\">Il silenzio sar\u00e0 il tuo miglior compagno di viaggio. <\/span><span style=\"font-weight: 400\">\r\n<\/span><span style=\"font-weight: 400\">La natura chiede solo una cosa per essere apprezzata davvero: la tua tranquillit\u00e0 interiore. <\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000002022,
            "tappa_id": 400000202,
            "descrizione_breve": "",
            "descrizione": null,
            "lingua_id": 2,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000002031,
            "tappa_id": 400000203,
            "descrizione_breve": "",
            "descrizione": "<span style=\"font-weight: 400\">Riprendi il sentiero principale in direzione di <\/span><b>Valcaldara<\/b><span style=\"font-weight: 400\">, territorio conosciuto per il torrente da cui prende il nome e per le sue sorgenti naturali, e dopo circa 2 km ti troverai di fronte alla deviazione per la <\/span><b>Chiesa di San Nicol\u00f2<\/b><span style=\"font-weight: 400\">, attorno alla quale sorgono i ruderi dell\u2019antico castello appartenente ai da Varano.<\/span><span style=\"font-weight: 400\">\r\n<\/span><span style=\"font-weight: 400\">Continua sulla carrareccia precedentemente percorsa e al km 11.5 imbocca un sentiero alternativo che ti condurr\u00e0 direttamente alle cascate di Valcaldara: la prima di dimensioni pi\u00f9 modeste e la seconda, pi\u00f9 grande, costituita da due salti d\u2019acqua. <\/span><span style=\"font-weight: 400\">\r\n<\/span><span style=\"font-weight: 400\">Un\u2019atmosfera unica che evoca immagini e sensazioni fiabesche.<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000002032,
            "tappa_id": 400000203,
            "descrizione_breve": "",
            "descrizione": null,
            "lingua_id": 2,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000002041,
            "tappa_id": 400000204,
            "descrizione_breve": "",
            "descrizione": "<span style=\"font-weight: 400\">Dopo una breve sosta rigenerante alla cascate, riprendi il cammino fino ad arrivare al muro a secco e ricongiungiti con la carrareccia iniziale. Prosegui fino alle <\/span><b>Vene di Valcaldara<\/b><span style=\"font-weight: 400\">, luogo ameno da dove, in primavera, sgorgano piccole sorgenti direttamente dal terreno.<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000002042,
            "tappa_id": 400000204,
            "descrizione_breve": "",
            "descrizione": null,
            "lingua_id": 2,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
        {
            "id": 4000002051,
            "tappa_id": 400000205,
            "descrizione_breve": "",
            "descrizione": "<span style=\"font-weight: 400\">La quiete della montagna ti accompagna lungo il tragitto del ritorno a Selvapiana. Qui la natura non \u00e8 uno sfondo, ma la vera protagonista di un documentario vivente.\r\n<\/span><span style=\"font-weight: 400\">Concediti, anche solo per un attimo, di essere un piccolo spettatore di fronte alla sua maestosa bellezza.<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:38:42",
            "uuid": ""
        },
