    "PERCORSI_TEXT": [
        {
            "id": 35000011,
            "percorso_id": "3500001",
            "descrizione_breve": "Dalla Chiesa di San Giovanni Battista alla Fonte delle cocce",
            "descrizione": "<span style=\"font-weight: 400\">Il percorso partir\u00e0 dalla Chiesa di San Giovanni Battista, situata in localit\u00e0 Castello e proseguir\u00e0 in direzione della Fonte delle cocce, dove sar\u00e0 possibile riempire le proprie borracce con acqua potabile. Da qui si continuer\u00e0 in direzione della Fonte del Piscio, luogo ameno circondato da faggete con piante secolari in cui poter sostare e fare un picnic. Al ritorno, passando per Pontile, si potr\u00e0 visitare la Chiesa di San Pietro, proseguendo per San Cassiano.<\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-17 14:27:53",
            "uuid": ""
        },
        {
