    "PERCORSI_TEXT": [
        {
            "id": 54000011,
            "percorso_id": "5400001",
            "descrizione_breve": "Scopri opere d'arte nascoste nei luoghi pi\u00f9 significativi del paese",
            "descrizione": "<span style=\"font-weight: 400\">Percorso con realt\u00e0 aumentata: l\u2019itinerario accompagner\u00e0 il visitatore a scoprire opere e quadri d\u2019arte contemporanea esposti non solo nella Pinacoteca cittadina ma anche nei luoghi pi\u00f9 significativi del paese, tra cui le botteghe artigiane.\u00a0<\/span><span style=\"font-weight: 400\">\r\n<\/span>\r\n\r\n<span style=\"font-weight: 400\">(Pinacoteca comunale, Bar Silio, Centro Culturale \u201cE. Pasquali, E\u2019tico Sartoria marchigiana, Laboratorio \u201cTerre d\u2019Arte\u201d, Misidia, Qui Vago- Ospitalit\u00e0 diffusa, Samuela Salvucci Creativa di Gioie)\u00a0<\/span>\r\n\r\n&nbsp;",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-21 09:03:36",
            "uuid": ""
        },
        {
