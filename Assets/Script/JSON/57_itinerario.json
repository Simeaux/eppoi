        {
            "id": 57000011,
            "percorso_id": "5700001",
            "descrizione_breve": "Dalla Cascata dello Scarzito al Bosco incantato",
            "descrizione": "<span style=\"font-weight: 400\">Si parte dalla Cascata dello Scarzito, presente all\u2019ingresso di Sefro e, proseguendo poi verso Rocca Varano, meta suggestiva per il suo valore storico, si attraversa Piazza Bellanti, sede del Municipio.\u00a0<\/span>\r\n\r\n<span style=\"font-weight: 400\">\u00c8 consigliato fare una piccola sosta presso la bottega \u201cLa nicchia dei sapori\u201d per assaporare alcuni dei prodotti tipici locali. Terminata la sosta si prosegue in direzione del bosco incantato, un luogo magico abitato da fate e gnomi. <\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-21 09:11:11",
            "uuid": ""
        },
