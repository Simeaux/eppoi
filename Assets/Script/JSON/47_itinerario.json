    "PERCORSI_TEXT": [
        {
            "id": 47000011,
            "percorso_id": "4700001",
            "descrizione_breve": "Passeggia per il centro storico e ammira il paese dal suo punto pi\u00f9 alto",
            "descrizione": "I<span style=\"font-weight: 400\">l percorso porter\u00e0 alla scoperta del centro storico di Petriolo partendo dal Santuario dei caduti di guerra. Si proseguir\u00e0 in direzione della Piazza San Martino, dove sorgono la Torre Civica e il Santuario della Madonna della Misericordia. Il cammino continuer\u00e0 verso la Chiesa di San Martino e San Marco per concludersi al Belvedere del paese. <\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-21 09:00:08",
            "uuid": ""
        },
        {
