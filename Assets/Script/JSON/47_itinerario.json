        {
            "id": 47000021,
            "percorso_id": "4700002",
            "descrizione_breve": "Scopri le bellezze del paese",
            "descrizione": "<span style=\"font-weight: 400\">Il percorso accompagner\u00e0 il visitatore a scoprire alcune delle bellezze del paese, passando per il Teatro Comunale e visitando i tre Musei, il Museo dei Legni Processionali, il Museo Diego De Minicis e il Museo delle macchine parlanti. Durante il cammino all\u2019interno del borgo sar\u00e0 possibile gustare e acquistare alcuni prodotti tipici locali. <\/span>",
            "lingua_id": 1,
            "attivo": "Y",
            "mod_dte": "2025-07-21 09:00:08",
            "uuid": ""
